# Copia este archivo como .env y pega tu clave.
# Clave gratuita de Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_aqui_tu_clave

# Modelos de respaldo si el principal agota su cuota diaria gratuita
# MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash

# Correos del equipo de la cuenta (se usan para consultar disponibilidad y agendar)
# EQUIPO_CUENTA=gestor@utpconsult.pe,lider.tecnico@utpconsult.pe

# Opcional: otro proveedor compatible con OpenAI (por ejemplo Groq)
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MODELO_CHAT=llama-3.3-70b-versatile
# PROVEEDOR=Groq (capa gratuita)
